{
  "name": "doorking-web",
  "version": "1.0.0",
  "private": true,
  "description": "Rebuild of the DoorKing32.exe desktop app: manages DoorKing gates through DKS Cloud.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node web/server.ts",
    "dev": "vite --config web/ui/vite.config.mts",
    "build": "vite build --config web/ui/vite.config.mts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/ui/tsconfig.json",
    "test": "node --test"
  },
  "type": "module",
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "nodemailer": "^10.5.0",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swagger-ui-dist": "^5.34.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
