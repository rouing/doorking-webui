{
  "name": "doorking-web-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone React + MUI + PWA frontend for DoorKing Gate Manager (REST API client).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy:www": "vite build && rm -rf /var/www/doorking-web-ui/* && cp -a dist/. /var/www/doorking-web-ui/",
    "preview": "vite preview",
    "gen:types": "npx --yes orval@8.49.0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-virtual": "^3.14.26",
    "libphonenumber-js": "^1.13.17",
    "papaparse": "^5.7.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "license": "MIT"
}
