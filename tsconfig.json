{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "files": ["web/ui/vite.config.mts"],
  "include": ["src", "web/*.ts", "*.ts"],
  "exclude": ["node_modules", "web/ui", "web/dist"]
}
